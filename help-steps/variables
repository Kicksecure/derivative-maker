## Static-analysis waivers for this legacy, sourced build library:
## - intentional word-splitting of command arguments;
## - 'command -v' for dependency probing during early bootstrap, before the
##   'has' helper is guaranteed present;
## - 'rm' of specific, known files (not user-supplied paths);
## - EMPTY_DIR="/tmp/empty" is a path INSIDE the build chroot
##   (${CHROOT_FOLDER}/${EMPTY_DIR}), not a host temp dir, so ${TMP} is wrong.
# shellcheck disable=SC2086
## style-ok: no-has
## style-ok: no-safe-rm
## style-ok: no-tmp-hardcode

#set -x
set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

## Same-shell idempotency: a second 'source help-steps/variables' in THIS shell
## returns immediately, so accumulators (DIST_APTGETOPT, pkg_list, SKIP_SCRIPTS,
## ...) are not re-appended and side effects do not re-run. 'variables_finalized'
## is set at the very end (after all modules) and is deliberately NOT exported --
## it guards a same-shell re-source only; a fresh process (every build step) has
## it unset and resolves normally. On a '--dump' run the dump hook exits before
## the end-of-file set, so the flag never lands in a variable snapshot.
if [ "${variables_finalized:-}" = "true" ]; then
   return 0
fi

MYDIR="$( cd -- "$( dirname -- "${BASH_SOURCE[0]}" )" && pwd )"
[ -n "${source_code_folder_dist:-}" ] || source_code_folder_dist="$(dirname -- "${MYDIR}")"
export source_code_folder_dist

[ -n "${HELPER_SCRIPTS_PATH:-}" ] || HELPER_SCRIPTS_PATH="${source_code_folder_dist}/packages/kicksecure/helper-scripts"
export HELPER_SCRIPTS_PATH

# shellcheck source=../packages/kicksecure/helper-scripts/usr/libexec/helper-scripts/strings.bsh
source "${HELPER_SCRIPTS_PATH}"/usr/libexec/helper-scripts/strings.bsh

## Load the split variable-resolution modules from the top-level buildconfig.d/
## (a sibling of help-steps/, = source_code_folder_dist), in explicit order. The
## base path variables above were resolved from THIS file's own location; the
## modules inherit them rather than recomputing from their own BASH_SOURCE.
## Sourced by explicit name (not a glob loop) so the load order is visible and no
## plumbing loop variable leaks into the captured build environment. (buildconfig.d
## also holds the *.conf config snippets, sourced separately as the config layer;
## the loader sources only the *.bsh resolver modules here.)
##
## 05_lib.bsh (set_default_variable + derive_unified_image_paths) loads first so
## the later modules can call those helpers; it is a separate, sourced-only file
## (not inlined) so a unit test can source and call the helpers directly.
# shellcheck source=../buildconfig.d/05_lib.bsh
source "${source_code_folder_dist}/buildconfig.d/05_lib.bsh"
# shellcheck source=../buildconfig.d/00_preamble.bsh
source "${source_code_folder_dist}/buildconfig.d/00_preamble.bsh"
# shellcheck source=../buildconfig.d/10_core.bsh
source "${source_code_folder_dist}/buildconfig.d/10_core.bsh"
# shellcheck source=../buildconfig.d/20_initramfs-iso-io.bsh
source "${source_code_folder_dist}/buildconfig.d/20_initramfs-iso-io.bsh"
# shellcheck source=../buildconfig.d/30_version-paths.bsh
source "${source_code_folder_dist}/buildconfig.d/30_version-paths.bsh"
# shellcheck source=../buildconfig.d/40_upload.bsh
source "${source_code_folder_dist}/buildconfig.d/40_upload.bsh"
# shellcheck source=../buildconfig.d/50_config-signing-pgp.bsh
source "${source_code_folder_dist}/buildconfig.d/50_config-signing-pgp.bsh"
# shellcheck source=../buildconfig.d/60_repos-cowbuilder-dump.bsh
source "${source_code_folder_dist}/buildconfig.d/60_repos-cowbuilder-dump.bsh"

## Mark this shell's variable resolution complete so a second 'source
## help-steps/variables' in the SAME shell is a no-op (each module early-returns
## on this flag) rather than re-appending accumulators. Deliberately NOT
## exported: it guards a same-shell re-source only; an exported flag would make
## child processes (build steps, recursive derivative-maker/genmkfile) skip
## resolution entirely. On a '--dump' run the dump hook in the last module exits
## before reaching this line, so the flag never appears in a variable snapshot.
variables_finalized="true"
